{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "esModuleInterop": true,
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "useDefineForClassFields": false
