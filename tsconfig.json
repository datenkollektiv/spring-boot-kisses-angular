{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "esModuleInterop": true,
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true
  }
}
